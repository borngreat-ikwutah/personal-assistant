# Non-secret public vars also live in wrangler.jsonc "vars" so they deploy automatically.
# Secrets (e.g. API_SECRET) must NOT go here; set them in the deployed worker via:
#   wrangler secret put <NAME>
APP_NAME=personal-assistant

# trigger.dev (dev environment; used by `trigger.dev dev` and the /ai/test endpoint)
TRIGGER_SECRET_KEY=
GROQ_API_KEY=
CRAWL_AI_KEY=

# Required in both the Worker and Trigger.dev environments for Telegram job search.
TELEGRAM_BOT_TOKEN=
# Worker-only secret passed to Telegram when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
# Worker-only Telegram chat allowed to run commands. Negative group IDs are supported.
TELEGRAM_CHAT_ID=

# Trigger.dev direct read access to the private R2 CV bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=personal-assistant-cv

# HMAC secret (at least 32 random bytes) for short-lived browser submission approvals.
BROWSER_APPROVAL_SECRET=

# Freehire MCP runs only inside Trigger.dev. The Worker receives normalized listings, never this token.
FREEHIRE_TOKEN=
FREEHIRE_OPERATION_TIMEOUT_MS=30000
JOB_AGENT_API_URL=
JOB_AGENT_API_SECRET=
