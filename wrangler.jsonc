// Cloudflare Workers configuration
// https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "minify": true,
  "vars": {
    "APP_NAME": "personal-assistant"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-assistant",
      "database_id": "1b830555-8e89-4286-8c19-3b2268783815"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CV_FILES",
      "bucket_name": "personal-assistant-cv"
    }
  ],
  "secrets": {
    "required": ["API_SECRET", "TELEGRAM_BOT_TOKEN"]
  }
}
